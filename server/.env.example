# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here

# Session Secret
SESSION_SECRET=your-session-secret-here

# MongoDB (not installed — using JSON file persistence)
# MONGODB_URI=mongodb://localhost:27017/camera_security

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Client URL (for redirects)
CLIENT_URL=http://localhost:3000

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AI Detection Settings
DETECTION_CONFIDENCE_THRESHOLD=0.75
ALERT_COOLDOWN_SECONDS=120
MAX_ALERTS_PER_HOUR=10

# Live websocket streamer FPS (lower = less bandwidth, higher = smoother)
LIVE_STREAM_FPS=30
# Live streamer JPEG quality (0-100)
LIVE_STREAM_QUALITY=85

# Camera Settings
CAMERA_FPS=30
CAMERA_RESOLUTION_WIDTH=1920
CAMERA_RESOLUTION_HEIGHT=1080

# H.264 Streaming (FFmpeg + WebCodecs)
H264_WIDTH=1280
H264_HEIGHT=720
H264_BITRATE=2500
FFMPEG_PATH=/path/to/ffmpeg

# Notifications
NOTIFICATIONS_DRY_RUN=false
